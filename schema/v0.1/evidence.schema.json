{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:manual-publishing-contract:v0.1:evidence",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "manual_id", "section_id", "source_id", "source_pages"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "manual_id": {"type": "string", "minLength": 1},
    "section_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
  }
}
