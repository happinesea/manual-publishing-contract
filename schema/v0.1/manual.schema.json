{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:manual-publishing-contract:v0.1:manual",
  "title": "Manual Publishing Contract Manual",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "manual_id", "family_id", "title", "language", "version", "source", "sections", "publication", "provenance"],
  "properties": {
    "contract_version": {"const": "0.1"},
    "manual_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "version": {"type": "string", "minLength": 1},
    "supersedes": {"type": "string", "minLength": 1},
    "source": {"$ref": "urn:manual-publishing-contract:v0.1:source"},
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "urn:manual-publishing-contract:v0.1:section"}},
    "publication": {"$ref": "urn:manual-publishing-contract:v0.1:publication"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "evidence"],
      "properties": {
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "items": {"$ref": "urn:manual-publishing-contract:v0.1:evidence"}}
      }
    }
  }
}
