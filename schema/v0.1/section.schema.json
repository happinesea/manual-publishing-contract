{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:manual-publishing-contract:v0.1:section",
  "title": "Manual Section",
  "type": "object",
  "additionalProperties": false,
  "required": ["section_id", "title", "source", "web"],
  "properties": {
    "section_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pages"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"type": "string", "pattern": "^/"}}
    },
    "tables": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "figures": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_page"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_page": {"type": "integer", "minimum": 1}
      }
    }
  }
}
