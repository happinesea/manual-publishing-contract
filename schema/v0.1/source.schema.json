{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:manual-publishing-contract:v0.1:source",
  "title": "Source Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "type", "title", "language", "version", "published_at", "file_name", "checksum"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["pdf", "html", "docx", "markdown", "other"]},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "version": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date"},
    "file_name": {"type": "string", "minLength": 1},
    "uri": {"type": "string", "format": "uri"},
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    }
  }
}
